{
  "formatVersion": 1,
  "profile": "paper-only",
  "tools": {
    "analyze_market": {
      "input": {
        "symbol": "BTC"
      },
      "expected": {
        "outcome": "success",
        "assertions": [
          {
            "path": "/structuredContent/symbol",
            "equals": "BTC"
          },
          {
            "path": "/structuredContent/ticker/markPx",
            "equals": "50000"
          }
        ]
      }
    },
    "analyze_markets_batch": {
      "input": {
        "symbols": [
          "BTC",
          "ETH"
        ]
      },
      "expected": {
        "outcome": "success",
        "assertions": [
          {
            "path": "/structuredContent/snapshots/0/symbol",
            "equals": "BTC"
          },
          {
            "path": "/structuredContent/snapshots/1/symbol",
            "equals": "ETH"
          }
        ]
      }
    },
    "automated_trading_status": {
      "input": {},
      "expected": {
        "outcome": "success",
        "assertions": [
          {
            "path": "/structuredContent/text",
            "matches": "^Shared automation policy metadata only; no paper or live order authority is granted:"
