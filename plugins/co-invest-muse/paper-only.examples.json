    "execute_order": {
      "input": {
        "symbol": "BTC",
        "side": "buy",
        "size": 100,
        "leverage": 5,
        "type": "market",
        "maxSlippageBps": 100,
        "confirmed": true,
        "executionMode": "paper",
        "idempotencyKey": "matrix-paper-order-1"
      },
      "expected": {
        "outcome": "success",
        "assertions": [
          {
            "path": "/structuredContent/order/exchange",
            "equals": "paper"
          },
          {
            "path": "/structuredContent/order/status",
            "equals": "filled"
          },
          {
            "path": "/structuredContent/order/symbol",
            "equals": "BTC-PERP"
          }
        ]
      }
    },
    "execute_orders_batch": {
      "input": {
        "orders": [
          {
            "symbol": "BTC",
            "side": "buy",
            "size": 100,
            "leverage": 5,
            "type": "market"
          },
          {
            "symbol": "ETH",
            "side": "buy",
            "size": 100,
            "leverage": 5,
            "type": "market"
          }
        ],
        "confirmed": true,
        "executionMode": "paper",
        "idempotencyKey": "matrix-paper-batch-1"
      },
      "expected": {
        "outcome": "success",
        "assertions": [
          {
            "path": "/structuredContent/status",
            "equals": "all_executed"
          },
          {
            "path": "/structuredContent/succeeded",
            "equals": 2
          },
          {
            "path": "/structuredContent/failed",
            "equals": 0
          }
        ]
      }
    },
    "execute_prediction_order": {
      "input": {
        "market_id": "600",
